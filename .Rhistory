n_cores <- detectCores() - 2
dag <- dagitty("dag {
Z1 -> Death
Z2 -> Death
Z1 -> D
Z2 -> D
Z3 -> D
}")
coordinates(dag) <- list(
x = c(Z1 = 0, Z2 = 0, Z3 = 0, D = 1.5, Death = 1.5),
y = c(Z1 = 1, Z2 = 0.5, Z3 = 0, D = 0, Death = 1)
)
plot(dag)
# ---------------------------
# Hazard model parameters
# ---------------------------
beta_0 <- -1.2
beta_D <- -1.0
beta_Z1 <- 0.5
beta_Z2 <- 0.4
beta_Z1Z2 <- 0.5
generate_data_noninf <- function(n = 1000) {
mu <- rep(0, 3)
sigma <- matrix(c(1, 0, 0, 0, 1, 0, 0, 0, 1), nrow = 3)
Z <- mvrnorm(n, mu, sigma) # i.i.d. baseline covariates with mean zero and variance 1
Z1 <- Z[, 1]
Z2 <- Z[, 2]
Z3 <- Z[, 3]
logit_p <- (-0.1 + 0.4 * Z1 + 0.4 * Z2 + 0.5 * Z3)
p <- plogis(logit_p) # exp(logit_p) / (1 + exp(logit_p))
D <- rbinom(n, 1, p) # Treatment indicator
hazard <- exp(beta_0 + beta_D * D + beta_Z1 * Z1 + beta_Z2 * Z2 + beta_Z1Z2 * Z1 * Z2)
T_event <- rexp(n, rate = hazard) # Event time from an exponential model
hazard_cen <- exp(-2.3 + 1.0 * D + 0.8 * Z1 + 1.0 * Z2)
T_censor <- rexp(n, rate = hazard_cen) # Censoring time based on treatment and other covariates
T_admin <- rep(7, n) # Administrative (random) censoring at time 7
Time <- pmin(T_event, T_censor, T_admin) # Observed follow-up time
Event <- as.numeric(T_event <= T_censor & T_event <= T_admin) # Event indicator
Censored <- as.numeric(T_event > T_censor & T_event <= T_admin) # Censoring indicator
return(data.frame(Z1 = Z1, Z2 = Z2, Z3 = Z3, D = D, Time = Time, Event = Event, Censored = Censored))
}
data <- generate_data_noninf()
attr(data$Z1, "label") <- "Baseline value of Z1"
attr(data$Z2, "label") <- "Baseline value of Z2"
attr(data$Z3, "label") <- "Baseline value of Z3"
attr(data$D, "label") <- "Treatment indicator (1 = treated, 0 = control)"
attr(data$Time, "label") <- "Time index for longitudinal records"
attr(data$Event, "label") <- "Event indicator (1 = event occurred, 0 = otherwise)"
attr(data$Censored, "label") <- "Censoring indicator (1 = censored, 0 = otherwise)"
get_label <- function(x) {
lbl <- attr(x, "label", exact = TRUE)
if (is.null(lbl)) "" else as.character(lbl)
}
dict <- data.frame(
Variable = names(data),
Meaning  = vapply(data, get_label, character(1)),
check.names = FALSE
)
knitr::kable(dict, caption = "Data Dictionary", row.names = FALSE)
summary(data$Time)
table(data$Event)
censored_subjects <- data[data$Event == 0, ]
(early_dropout <- sum(censored_subjects$Time < 7))
(admin_censored <- sum(censored_subjects$Time >= 7))
get_true_survival <- function(data, t, D) {
hazard <- exp(beta_0 + beta_D * D + beta_Z1 * data$Z1 + beta_Z2 * data$Z2 + beta_Z1Z2 * data$Z1 * data$Z2)
survival_probs <- exp(-hazard * t) # Baseline hazard is constant under an expotential survival model
return(mean(survival_probs))
}
# Compute potential survival probabilities by setting treatment to 1 and 0 for all individuals
times <- c(1, 2, 3)
true_surv_1 <- sapply(times, function(t) get_true_survival(data, t, D = 1))
true_surv_0 <- sapply(times, function(t) get_true_survival(data, t, D = 0))
# Calculate ATE as difference in survival probabilities
results_true <- list(ATE = true_surv_1 - true_surv_0)
