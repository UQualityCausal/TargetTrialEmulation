#rmse_3_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = FALSE, cen_correct = TRUE, or_correct = TRUE)
# Scenario 4: PS incorrect, Cen incorrect, OR correct
rmse_4_asymp <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "asymptotic",
ps_correct = FALSE, cen_correct = FALSE, or_correct = TRUE)
#rmse_4_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = FALSE, cen_correct = FALSE, or_correct = TRUE)
# Scenario 5: PS correct, Cen correct, OR incorrect
rmse_5_asymp <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "asymptotic",
ps_correct = TRUE, cen_correct = TRUE, or_correct = FALSE)
#rmse_5_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = TRUE, cen_correct = TRUE, or_correct = FALSE)
# Scenario 6: PS correct, Cen incorrect, OR incorrect
rmse_6_asymp <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "asymptotic",
ps_correct = TRUE, cen_correct = FALSE, or_correct = FALSE)
#rmse_6_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = TRUE, cen_correct = FALSE, or_correct = FALSE)
# Scenario 7: PS incorrect, Cen correct, OR incorrect
rmse_7_asymp <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "asymptotic",
ps_correct = FALSE, cen_correct = TRUE, or_correct = FALSE)
#rmse_7_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = FALSE, cen_correct = TRUE, or_correct = FALSE)
# Scenario 8: All models incorrect
rmse_8_asymp <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "asymptotic",
ps_correct = FALSE, cen_correct = FALSE, or_correct = FALSE)
#rmse_8_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = FALSE, cen_correct = FALSE, or_correct = FALSE)
# Scenario 0: crude estimator
rmse_crude <- calculate_rmse(datasets, true_ate_samples, times, method = "crude")
scenarios <- c(
"0: Crude Cox",
