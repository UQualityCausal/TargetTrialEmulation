rmse_7_asymp <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "asymptotic",
ps_correct = FALSE, cen_correct = TRUE, or_correct = FALSE)
#rmse_7_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = FALSE, cen_correct = TRUE, or_correct = FALSE)
# Scenario 8: All models incorrect
rmse_8_asymp <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "asymptotic",
ps_correct = FALSE, cen_correct = FALSE, or_correct = FALSE)
#rmse_8_boot <- calculate_rmse(datasets, true_ate_samples, times, method = "package", variance = "bootstrap",
#ps_correct = FALSE, cen_correct = FALSE, or_correct = FALSE)
# Scenario 0: crude estimator
rmse_crude <- calculate_rmse(datasets, true_ate_samples, times, method = "crude")
scenarios <- c(
"0: Crude Cox",
"1: All Correct",
"2: PS Correct, Cen Incorrect, OR Correct",
"3: PS Incorrect, Cen Correct, OR Correct",
"4: PS Incorrect, Cen Incorrect, OR Correct",
"5: PS Correct, Cen Correct, OR Incorrect",
"6: PS Correct, Cen Incorrect, OR Incorrect",
"7: PS Incorrect, Cen Correct, OR Incorrect",
"8: All Incorrect")
# Combine RMSE values across all time points into a single string
format_rmse <- function(rmse_vector) {
paste(sprintf("%.3f", rmse_vector), collapse = ", ")
}
# Asymptotic column
asymp_rmse <- c(format_rmse(rmse_crude),
format_rmse(rmse_1_asymp), format_rmse(rmse_2_asymp), format_rmse(rmse_3_asymp), format_rmse(rmse_4_asymp),
format_rmse(rmse_5_asymp), format_rmse(rmse_6_asymp), format_rmse(rmse_7_asymp), format_rmse(rmse_8_asymp))
# Bootstrap column
# boot_rmse <- c(format_rmse(rmse_1_boot), format_rmse(rmse_2_boot), format_rmse(rmse_3_boot), format_rmse(rmse_4_boot),
#                format_rmse(rmse_5_boot), format_rmse(rmse_6_boot), format_rmse(rmse_7_boot), format_rmse(rmse_8_boot))
#rmse_table <- data.frame(Scenario = scenarios, Asymptotic = asymp_rmse, Bootstrap = boot_rmse)
# kable(rmse_table,
#       col.names = c("Scenario", "T = 1, 2, 3", "T = 1, 2, 3"),
#       caption = "Performance of the AIPWCC estimator (RMSE)",
#       align = c('c', 'c', 'c')) %>%
#   kable_styling(full_width = FALSE, font_size = 12) %>%
#   add_header_above(c(" " = 1, "Asymptotic" = 1, "Bootstrap" = 1))
rmse_table <- data.frame(Scenario = scenarios, Asymptotic = asymp_rmse)
kable(rmse_table,
col.names = c("Scenario", "T = 1, 2, 3"),
caption = "Performance of the AIPWCC estimator (RMSE)",
align = c('c', 'c', 'c')) %>%
kable_styling(full_width = FALSE, font_size = 12) %>%
add_header_above(c(" " = 1, "Asymptotic" = 1))
