"site_pleura", "site_soft_tissue", "site_gi", "site_cns", "site_other",
"ebv_status", "ebv_quant", "autoimmune_history", "ldh_dx", "wbc_dx", "hgb_dx",
"albumin_dx", "ldh_high", "lymphopenia"
)
# Check which variables exist in the dataset
covariates_pfs_check <- covariates_pfs_check[covariates_pfs_check %in% names(pfs_data_analysis)]
cat("##############################################################\n")
cat("## STEP 1: CHECKING FOR SPARSITY IN COVARIATES\n")
cat("##############################################################\n\n")
# Final covariates for PFS analysis (excluding sparse variables)
covariates_pfs <- setdiff(covariates_pfs_check, sparse_vars)
cat(sprintf("\n%d covariates retained for analysis after sparsity check\n", length(covariates_pfs)))
cat("Variables excluded due to sparsity:\n")
print(sparse_vars)
cat("\n")
cat("##############################################################\n")
cat("## STEP 2: UNIVARIATE COX REGRESSION FOR PFS\n")
cat("##############################################################\n\n")
# Function to extract HR with 95% CI from Cox model (handles multiple categories)
extract_hr_pfs <- function(var, data) {
tryCatch({
# Count missing values
missing_count <- sum(is.na(data[[var]]))
# Fit Cox proportional hazards model
formula_str <- as.formula(paste("Surv(PFSTime, PFSEvent) ~", var))
model <- coxph(formula_str, data = data)
s <- summary(model)
# Extract coefficients
if (nrow(s$coefficients) < 1) {
return(data.frame(
Variable = var,
Coefficient = var,
HR = NA,
CI_Lower = NA,
CI_Upper = NA,
P_Value = NA,
Missing = missing_count
))
}
# Get all coefficient names
coef_names <- rownames(s$coefficients)
# Extract results for each coefficient
results_list <- lapply(seq_along(coef_names), function(i) {
data.frame(
Variable = var,
Coefficient = coef_names[i],
HR = s$coef[i, "exp(coef)"],
CI_Lower = s$conf.int[i, "lower .95"],
CI_Upper = s$conf.int[i, "upper .95"],
P_Value = s$coef[i, "Pr(>|z|)"],
Missing = missing_count
)
})
# Combine all coefficients into one dataframe
do.call(rbind, results_list)
}, error = function(e) {
data.frame(
Variable = var,
Coefficient = var,
HR = NA,
CI_Lower = NA,
CI_Upper = NA,
P_Value = NA,
Missing = sum(is.na(data[[var]]))
)
})
}
# Apply function to all covariates (now returns data frames)
results_cox_pfs <- lapply(covariates_pfs, extract_hr_pfs, data = pfs_data_analysis)
# Combine all results into a single data frame
results_df_pfs <- do.call(rbind, results_cox_pfs)
# Add descriptive labels using both Variable and Coefficient columns
results_df_pfs <- results_df_pfs %>%
mutate(
Label = case_when(
Variable == "age_dx" ~ "Age at Diagnosis",
Variable == "AgeGroup" ~ "Age Group: ≥60 (vs <60)",
Variable == "gender" ~ "Gender: Female (vs Male)",
Variable == "race" ~ "Race",
Variable == "ethnicity" ~ "Ethnicity: Non-Hispanic (vs Hispanic)",
Variable == "chl_subtype" ~ "CHL Subtype",
Variable == "ips_cat" ~ "IPS Category: 4-7 (vs 0-3)",
Variable == "stage_binary" ~ "Stage: IV (vs II/III)",
Variable == "ecog_binary" ~ "ECOG: 0-1 (vs 2+)",
Variable == "b_symptoms" ~ "B Symptoms: Present (vs Absent)",
Variable == "esr_dx" ~ "ESR (mm/hr)",
Variable == "bulky_dx" ~ "Bulky Disease: Present (vs Absent)",
Variable == "en_yes" ~ "Extranodal Sites: Present (vs Absent)",
Coefficient == "en_count2 or more" ~ "Extranodal Sites: ≥2 (vs 0)",
Coefficient == "en_count1" ~ "Extranodal Sites: 1 (vs 0)",
Variable == "site_lung" ~ "Lung Involvement: Yes (vs No)",
Variable == "site_bone" ~ "Bone Involvement: Yes (vs No)",
Variable == "site_liver" ~ "Liver Involvement: Yes (vs No)",
Variable == "site_spleen" ~ "Spleen Involvement: Yes (vs No)",
Variable == "site_marrow" ~ "Bone Marrow Involvement: Yes (vs No)",
Variable == "site_pleura" ~ "Pleural Involvement: Yes (vs No)",
Variable == "site_soft_tissue" ~ "Soft Tissue Involvement: Yes (vs No)",
Variable == "site_gi" ~ "GI Involvement: Yes (vs No)",
Variable == "site_cns" ~ " CNS Involvement: Yes (vs No)",
Variable == "site_other" ~ "Other Site Involvement: Yes (vs No)",
Variable == "ebv_status" ~ "EBV Status: Positive (vs Negative)",
Variable == "ebv_quant" ~ "EBV Quant: Positive (vs Negative)",
Variable == "autoimmune_history" ~ "Autoimmune History: Yes (vs No)",
Variable == "ldh_dx" ~ "LDH (U/L)",
Variable == "wbc_dx" ~ "WBC (103/μL)",
Variable == "hgb_dx" ~ "Hemoglobin (g/dL)",
Variable == "albumin_dx" ~ "Albumin: Low (vs Normal)",
Variable == "ldh_high" ~ "Elevated LDH: Present (vs Absent)",
Variable == "lymphopenia" ~ "Lymphopenia: Present (vs Absent)",
TRUE ~ Coefficient  # Use Coefficient name as fallback for multi-category variables
)
)
# Display univariate results
cat("Univariate Cox Regression Results:\n\n")
print(results_df_pfs %>%
select(Label, HR, CI_Lower, CI_Upper, P_Value, Missing) %>%
mutate(
HR = sprintf("%.3f", HR),
CI_Lower = sprintf("%.3f", CI_Lower),
CI_Upper = sprintf("%.3f", CI_Upper),
P_Value = sprintf("%.4f", P_Value)
))
cat("\n##############################################################\n")
cat("## CREATING FOREST PLOT FOR PFS\n")
cat("##############################################################\n\n")
# Clean invalid or extreme values
est_pfs_clean <- results_df_pfs %>%
mutate(
HR = as.numeric(HR),
CI_Lower = as.numeric(CI_Lower),
CI_Upper = as.numeric(CI_Upper),
P_Value = as.numeric(P_Value)
) %>%
filter(
!is.na(HR), !is.na(CI_Lower), !is.na(CI_Upper),
is.finite(HR), is.finite(CI_Lower), is.finite(CI_Upper),
HR > 0, CI_Lower > 0, CI_Upper > 0
)
if (nrow(est_pfs_clean) == 0) {
stop("No valid HR values available for forest plot.")
}
# Check range to define safe xscale
hr_min <- min(est_pfs_clean$CI_Lower, na.rm = TRUE)
hr_max <- max(est_pfs_clean$CI_Upper, na.rm = TRUE)
# Cap extreme range
if (hr_max / hr_min < 2) {
# Too narrow to plot on log scale safely
hr_min <- hr_min * 0.5
hr_max <- hr_max * 2
}
xscale_range <- c(hr_min, hr_max)
cat(sprintf("PFS HR range: %.3f – %.3f\n", hr_min, hr_max))
# Create table for plotting
plot_display_pfs <- est_pfs_clean %>%
mutate(
Label = as.character(Label),
`Hazard Ratio` = sprintf("%.2f", HR),
`95% CI` = sprintf("(%.2f, %.2f)", CI_Lower, CI_Upper),
`P-Value` = sprintf("%.3f", P_Value)
) %>%
select(Label, `Hazard Ratio`, `95% CI`, `P-Value`)
# Add header row
header_row <- data.frame(
Label = "Variable",
`Hazard Ratio` = "Hazard Ratio",
`95% CI` = "95% CI",
`P-Value` = "P-Value",
check.names = FALSE
)
plot_display_pfs <- rbind(header_row, plot_display_pfs)
# Numeric vectors for forestplot
mean_vals <- c(NA, est_pfs_clean$HR)
lower_vals <- c(NA, est_pfs_clean$CI_Lower)
upper_vals <- c(NA, est_pfs_clean$CI_Upper)
is_summary <- c(TRUE, rep(FALSE, nrow(est_pfs_clean)))
safe_forestplot <- function(log_scale = TRUE) {
forestplot::forestplot(
x = plot_display_pfs,
mean = mean_vals,
lower = lower_vals,
upper = upper_vals,
is.summary = is_summary,
zero = 1,
xlog = log_scale,
boxsize = 0.3,
lineheight = unit(1, "cm"),
colgap = unit(5, "mm"),
xlab = "Hazard Ratio for Progression-Free Survival",
xticks = if (log_scale) c(0.1, 0.2, 0.5, 1, 2, 5) else pretty(xscale_range),
clip = if (log_scale) c(0.1, 5) else NULL,  # Clip values outside 0.1-5 range
graph.pos = 5,
txt_gp = forestplot::fpTxtGp(
label = gpar(cex = 1.6),
ticks = gpar(cex = 1.1),
xlab = gpar(cex = 1.3)
),
fn.ci_norm = fpDrawNormalCI,
vertices = TRUE
)
}
# Try plotting with log scale first, fallback to linear if it fails
fig_forest_pfs <- tryCatch({
safe_forestplot(log_scale = TRUE)
}, error = function(e) {
cat("Log-scale plotting failed, retrying with linear scale...\n")
safe_forestplot(log_scale = FALSE)
})
CairoPNG("Forest_Plot_PFS_older.png", width = plot_width, height = plot_height, units = "in", dpi = 600, antialias = "subpixel")
print(fig_forest_pfs)
dev.off()
pfs_data <- prepare_survival_data(one_cycle, outcome = "PFS")
# Fit Kaplan-Meier curves by age group
km_fit <- survfit(Surv(PFSTime, PFSEvent) ~ AgeGroup, data = pfs_data)
# Extract 1-year (12 months) PFS estimates
pfs_1year <- summary(km_fit, times = 12)
# Create a clean results table
results_1year <- data.frame(
AgeGroup = pfs_1year$strata,
N = pfs_1year$n,
Events = pfs_1year$n.event,
PFS_1year = pfs_1year$surv,
SE = pfs_1year$std.err,
CI_Lower = pfs_1year$lower,
CI_Upper = pfs_1year$upper
) %>%
mutate(
AgeGroup = gsub("AgeGroup=", "", AgeGroup),
PFS_1year_pct = PFS_1year * 100,
CI_Lower_pct = CI_Lower * 100,
CI_Upper_pct = CI_Upper * 100,
Display = sprintf("%.1f%% (95%% CI: %.1f-%.1f%%)",
PFS_1year_pct, CI_Lower_pct, CI_Upper_pct)
)
print(results_1year %>%
select(AgeGroup, N, Events, Display),
row.names = FALSE)
knitr::opts_chunk$set(
collapse = TRUE,
comment = "#>",
message = FALSE,
warning = FALSE
)
set.seed(123456)
library(truncnorm)
library(survival)
library(pseudo)
library(adjustedCurves)
library(MASS)
library(knitr)
library(kableExtra)
library(dagitty)
library(parallel)
library(future.apply)
library(future)
n_cores <- detectCores() - 2
dag <- dagitty("dag {
Z1 -> Death
Z2 -> Death
Z1 -> D
Z2 -> D
}")
coordinates(dag) <- list(
x = c(Z1 = 0, Z2 = 0, D = 1, Death = 1),
y = c(Z1 = 1, Z2 = 0, D = 0, Death = 1)
)
plot(dag)
# ---------------------------
# Hazard model parameters
# ---------------------------
beta_0 <- -2
beta_D <- -0.8
beta_Z1 <- 0.25
beta_Z2 <- 0.7
beta_Z1Z2 <- 0.9
beta_Z2sq <- 0.35
generate_data_noninf <- function(n = 2000) {
Z1 <- rnorm(n, 0, 1)
Z2 <- rnorm(n, 0.5, 1)
Z3 <- rnorm(n, 0, 0.5)
Z4 <- rnorm(n, 0, 1)
logit_p <- -0.1 + 0.5 * Z1 + 0.3 * Z2
p <- plogis(logit_p) # exp(logit_p) / (1 + exp(logit_p))
D <- rbinom(n, 1, p) # Treatment indicator
hazard <- exp(beta_0 + beta_D * D + beta_Z1 * Z1 + beta_Z2 * Z2 + beta_Z1Z2 * Z3 + beta_Z2sq * Z4)
T_event <- rexp(n, rate = hazard) # Event time from an exponential model
#summary(T_event)
T_censor <- rexp(n, rate = exp(-3)) # Censoring time based on random censoring
#summary(T_censor)
T_admin <- rep(5, n) # Administrative (random) censoring
Time <- pmin(T_event, T_censor, T_admin) # Observed follow-up time
Event <- as.numeric(T_event <= T_censor & T_event <= T_admin) # Event indicator
return(data.frame(Z1 = Z1, Z2 = Z2, Z3 = Z3, Z4 = Z4, D = D, Time = Time, Event = Event))
}
data <- generate_data_noninf()
attr(data$Z1, "label") <- "Baseline value of Z1"
attr(data$Z2, "label") <- "Baseline value of Z2"
attr(data$Z3, "label") <- "Baseline value of Z3"
attr(data$Z4, "label") <- "Baseline value of Z4"
attr(data$D, "label") <- "Treatment indicator (1 = treated, 0 = control)"
attr(data$Time, "label") <- "Time index for longitudinal records"
attr(data$Event, "label") <- "Event indicator (1 = event occurred, 0 = otherwise)"
get_label <- function(x) {
lbl <- attr(x, "label", exact = TRUE)
if (is.null(lbl)) "" else as.character(lbl)
}
dict <- data.frame(
Variable = names(data),
Meaning  = vapply(data, get_label, character(1)),
check.names = FALSE
)
knitr::kable(dict, caption = "Data Dictionary", row.names = FALSE)
summary(data$Time)
table(data$Event)
censored_subjects <- data[data$Event == 0, ]
(early_dropout <- sum(censored_subjects$Time < 5))
(admin_censored <- sum(censored_subjects$Time >= 5))
nrow(data[data$Event == 1 & data$Time <= 3, ])
get_true_survival <- function(data, t, D) {
hazard <- exp(beta_0 + beta_D * D + beta_Z1 * data$Z1 + beta_Z2 * data$Z2 + beta_Z1Z2 * data$Z3 + beta_Z2sq * data$Z4)
survival_probs <- exp(-hazard * t) # baseline hazard is constant under an expotential survival model
return(mean(survival_probs))
}
times <- c(2, 3, 4)
true_surv_1 <- sapply(times, function(t) get_true_survival(data, t, D = 1))
true_surv_0 <- sapply(times, function(t) get_true_survival(data, t, D = 0))
true_ate <- true_surv_1 - true_surv_0
pseudo_dr_ate_manual <- function(data, times, ps_correct = TRUE, or_correct = TRUE) {
# Outcome regression (Cox proportional hazard model)
if (or_correct) {
or_model <- coxph(Surv(Time, Event) ~ D + Z1 + Z2 + Z3 + Z4, data = data)
} else {
or_model <- coxph(Surv(Time, Event) ~ D + Z4 + Z3, data = data)
}
# Extract the linear predictors (Beta^T * Z) from fitted Cox models
data1 <- data
data1$D <- 1
data0 <- data
data0$D <- 0
lp_1 <- predict(or_model, newdata = data1, type = "lp")
lp_0 <- predict(or_model, newdata = data0, type = "lp")
bh <- basehaz(or_model, centered = FALSE)
bh$surv <- exp(-bh$hazard)
s0_f <- stepfun(bh$time, c(1, bh$surv))
s0_t <- S0_f(times)
m1 <- sapply(S0_t, function(s0) s0 ^ exp(lp_1))
m0 <- sapply(S0_t, function(s0) s0 ^ exp(lp_0))
# Propensity scores
if (ps_correct) {
ps_model <- glm(D ~ Z1 + Z2, data = data, family = "binomial")
} else {
ps_model <- glm(D ~ Z1 + Z3, data = data, family = "binomial")
}
e <- predict(ps_model, type = "response")
# Pseudo-observations (individual estimates of the survival function at specified time points)
pseudo_obs <- pseudosurv(time = data$Time, event = data$Event, tmax = times)$pseudo
surv_1 <- numeric(length(times))
surv_0 <- numeric(length(times))
ATE <- numeric(length(times))
for(j in 1:length(times)) {
# DR for treated group
term1_treated <- data$D * pseudo_obs[, j] / e
term2_treated <- (data$D - e) * m1[, j] / e
term_full_treated <- term1_treated - term2_treated
surv_1[j] <- mean(term_full_treated)
# DR for control group
term1_control <- (1 - data$D) * pseudo_obs[, j] / (1 - e)
term2_control <- (data$D - e) * m0[, j] / (1 - e)
term_full_control <- term1_control + term2_control
surv_0[j] <- mean(term_full_control)
ATE[j] <- surv_1[j] - surv_0[j]
}
return(list(ATE = ATE))
}
results_1 <- pseudo_dr_ate_manual(data, times, ps_correct = TRUE, or_correct = TRUE)
knitr::opts_chunk$set(
collapse = TRUE,
comment = "#>",
message = FALSE,
warning = FALSE
)
