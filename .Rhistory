)
)
obsdata5 <- obsdata5 %>%
arrange(id, follow_up) %>%
group_by(id) %>%
mutate(cum_censor_weight = cumprod(censor_weight)) %>%
ungroup()
# Calculate summary statistics for cumulative censoring weights by treatment group
censor_weight_summary <- obsdata5 %>%
mutate(treatment_group = factor(assigned_treatment,
levels = c(0, 1),
labels = c("Trt_0", "Trt_1"))) %>%
group_by(treatment_group) %>%
summarise(
min = min(cum_censor_weight, na.rm = TRUE),
max = max(cum_censor_weight, na.rm = TRUE),
mean = mean(cum_censor_weight, na.rm = TRUE),
sd = sd(cum_censor_weight, na.rm = TRUE),
.groups = "drop") %>%
mutate(across(c(min, max, mean, sd), ~ round(.x, 2)))
print(censor_weight_summary)
# Combined weight
obsdata5 <- obsdata5 %>%
left_join(obsdata6 %>% select(id, trt_weight_untrunc), by = "id") %>%
mutate(combi_weight = trt_weight_untrunc * cum_censor_weight)
comb_weight_cutoff <- quantile(obsdata5$combi_weight, 0.99, na.rm = T)
obsdata5 <- obsdata5 %>%
mutate(combi_weight = ifelse(combi_weight > comb_weight_cutoff, comb_weight_cutoff, combi_weight))
# Fit weighted pooled logistic regression (start from baseline time)
# Do not need to add other covariates as predictors for the unstablized weights case
data_filtered <- obsdata5 %>% filter(C != 1) # Exclude censored observations (C=1) because their outcomes are unknown
data_filtered$combi_weight <- as.numeric(data_filtered$combi_weight)
weighted_iptw_ipcw_model <- glm(Y ~ assigned_treatment * follow_up + I(follow_up^2),
data = data_filtered,
weights = combi_weight,
family = binomial)
summary(weighted_iptw_ipcw_model)
gen_cf_data <- function(data, trt) {
data_cf <- data %>% mutate(assigned_treatment = trt)
return(data_cf)
}
data_all_trt_1 <- gen_cf_data(obsdata5 %>% filter(C != 1), 1)
data_all_trt_0 <- gen_cf_data(obsdata5 %>% filter(C != 1), 0)
# Calculate conditional cumulative incidences (combined weights)
calc_condit_cum_inc <- function(outcome_model, data) {
pred_data <- data %>% select(all_of(c("id", "follow_up", "assigned_treatment")))
# Predict probabilities
pred_data$prob_outcome <- predict(outcome_model, newdata = pred_data, type = "response")
# Calculate cumulative incidence for each subject
cum_inc <- pred_data %>%
arrange(.data$id, .data$follow_up) %>%
group_by(.data$id) %>%
mutate(
surv_prob = cumprod(1 - .data$prob_outcome), # P(alive up to current time)
surv_prob_lag = lag(.data$surv_prob, default = 1), # P(alive up to last time)
death_prob = .data$surv_prob_lag * .data$prob_outcome, # P(dead at current time)
cum_inc = cumsum(.data$death_prob)
) %>% ungroup()
return(cum_inc)
}
condit_cum_inc_risk_1 <- calc_condit_cum_inc(weighted_iptw_ipcw_model, data_all_trt_1)
condit_cum_inc_risk_0 <- calc_condit_cum_inc(weighted_iptw_ipcw_model, data_all_trt_0)
marg_res <- bind_rows(
condit_cum_inc_risk_1 %>%
group_by(follow_up) %>%
summarise(mean_cum_inc = mean(cum_inc, na.rm = TRUE), .groups = "drop") %>%
mutate(risk = "risk_1"),
condit_cum_inc_risk_0 %>%
group_by(follow_up) %>%
summarise(mean_cum_inc = mean(cum_inc, na.rm = TRUE), .groups = "drop") %>%
mutate(risk = "risk_0")
)
# Calculate incidence differences and ratios
inc_comp <- marg_res %>%
select(follow_up, risk, mean_cum_inc) %>%
pivot_wider(names_from = risk, values_from = mean_cum_inc) %>%
mutate(risk_diff = risk_1 - risk_0, risk_ratio = risk_1 / risk_0)
# Marginal cumulative incidences at different time points
key_times <- c(182, 365) # 6 months and 1 year
# Find the closest time points in the data stratified by risk group
cum_inc_at_keys <- marg_res %>%
crossing(assess_time = key_times) %>%
filter(follow_up >= assess_time) %>%
group_by(risk, assess_time) %>%
slice_min(follow_up, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(risk, assess_time, mean_cum_inc) %>%
arrange(risk, assess_time) %>%
pivot_wider(names_from = risk, values_from = mean_cum_inc)
# Risk differences and ratios at different time points
risk_contrast_at_keys <- inc_comp %>%
crossing(assess_time = key_times) %>%
filter(follow_up >= assess_time) %>%
group_by(assess_time) %>%
slice_min(follow_up, n = 1, with_ties = FALSE) %>%
select(assess_time, risk_1, risk_0, risk_diff, risk_ratio) %>%
ungroup()
results_itt <- risk_contrast_at_keys %>% mutate(assess_time = as.integer(assess_time / 30), method = "ITT")
results_itt
# No weights
plr_model_unadj <- glm(Y ~ assigned_treatment + follow_up + I(follow_up^2),
data = obsdata5 %>% filter(C != 1),
family = binomial)
summary(plr_model_unadj)
condit_cum_inc_treated_unadj <- calc_condit_cum_inc(plr_model_unadj, data_all_trt_1)
condit_cum_inc_untreated_unadj <- calc_condit_cum_inc(plr_model_unadj, data_all_trt_0)
marginal_res_unadj <- bind_rows(
condit_cum_inc_treated_unadj %>%
group_by(follow_up) %>%
summarise(mean_cum_inc = mean(cum_inc, na.rm = TRUE), .groups = "drop") %>%
mutate(risk = "risk_1"),
condit_cum_inc_untreated_unadj %>%
group_by(follow_up) %>%
summarise(mean_cum_inc = mean(cum_inc, na.rm = TRUE), .groups = "drop") %>%
mutate(risk = "risk_0")
)
# Calculate incidence differences and ratios
inc_comp_unadj <- marginal_res_unadj %>%
select(follow_up, risk, mean_cum_inc) %>%
pivot_wider(names_from = risk, values_from = mean_cum_inc) %>%
mutate(risk_diff = risk_1 - risk_0, risk_ratio = risk_1 / risk_0)
# Marginal cumulative incidences at different time points
key_times <- c(182, 365) # 6 months and 1 year
cum_inc_at_keys_unadj <- marginal_res_unadj %>%
tidyr::crossing(assess_time = key_times) %>%
filter(follow_up >= assess_time) %>%
group_by(risk, assess_time) %>%
slice_min(follow_up, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(risk, assess_time, mean_cum_inc) %>%
arrange(risk, assess_time) %>%
pivot_wider(names_from = risk, values_from = mean_cum_inc)
cum_inc_at_keys_unadj
# Risk differences and ratios at different time points
risk_contrast_at_keys_unadj <- inc_comp_unadj %>%
crossing(assess_time = key_times) %>%
filter(follow_up >= assess_time) %>%
group_by(assess_time) %>%
slice_min(follow_up, n = 1, with_ties = FALSE) %>%
select(assess_time, risk_1, risk_0, risk_diff, risk_ratio) %>%
ungroup()
results_unadj <- risk_contrast_at_keys_unadj %>% mutate(assess_time = as.integer(assess_time / 30), method = "Unadjusted")
results_unadj
truth <- readRDS("risk_truth.rds")
ITT_truth <- truth$ITT.truth
ITT_truth1 <- ITT_truth %>%
filter(time %in% c(6, 12)) %>%
rename(assess_time = time, risk_1 = cumulative_incidence_trt1, risk_0 = cumulative_incidence_trt0,
risk_diff = risk_difference, risk_ratio = risk_ratio) %>%
mutate(method = "Truth")
all_results <- rbind(results_unadj, results_itt, ITT_truth1) %>%
select(assess_time, method, risk_1, risk_0, risk_diff, risk_ratio) %>%
pivot_wider(names_from = method, values_from = c(risk_1, risk_0, risk_diff, risk_ratio))
all_results %>%
kable(col.names = c("Time (months)", rep(c("Unadjusted", "ITT", "Truth"), 4)), digits = 2, align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE) %>%
add_header_above(c(" " = 1, "Risk (Trt 1)" = 3, "Risk (Trt 0)" = 3, "Risk Diff" = 3, "Risk Ratio" = 3))
# Scenario 1: non-informative censoring
km_weighted_s1 <- survfit(Surv(follow_up, outcome) ~ assigned_treatment,
data = obsdata6, weights = trt_weight)
km_summary_s1 <- summary(km_weighted_s1, times = key_times)
# CIF = 1 - S(t)
km_cif_s1 <- data.frame(assess_time = km_summary_s1$time, trt = km_summary_s1$strata,
cum_inc = 1 - km_summary_s1$surv,
ci_lower = 1 - km_summary_s1$upper, ci_upper = 1 - km_summary_s1$lower) %>%
mutate(
`Time (months)` = as.integer(assess_time / 30),
trt = ifelse(grepl("=0", trt), "Trt 0", "Trt 1"),
estimate = sprintf("%.2f (%.2f, %.2f)", cum_inc, ci_lower, ci_upper)
) %>%
select(`Time (months)`, trt, estimate) %>%
pivot_wider(names_from = trt, values_from = estimate)
km_cif_s1 %>%
kable(align = "c", caption = "Weighted KM Estimate (95% CI) — Scenario 1") %>%
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
# Scenario 2: informative censoring
obsdata_s2 <- obsdata6 %>%
left_join(obsdata5 %>% select(id, follow_up, combi_weight), by = c("id", "follow_up"))
km_weighted_s2 <- survfit(Surv(follow_up, outcome) ~ assigned_treatment,
data = obsdata_s2, weights = combi_weight)
km_summary_s2 <- summary(km_weighted_s2, times = key_times)
km_cif_s2 <- data.frame(assess_time = km_summary_s2$time, trt = km_summary_s2$strata,
cum_inc = 1 - km_summary_s2$surv,
ci_lower = 1 - km_summary_s2$upper, ci_upper = 1 - km_summary_s2$lower) %>%
mutate(
`Time (months)` = as.integer(assess_time / 30),
trt = ifelse(grepl("=0", trt), "Trt 0", "Trt 1"),
estimate = sprintf("%.2f (%.2f, %.2f)", cum_inc, ci_lower, ci_upper)
) %>%
select(`Time (months)`, trt, estimate) %>%
pivot_wider(names_from = trt, values_from = estimate)
km_cif_s2 %>%
kable(align = "c", caption = "Weighted KM Estimate (95% CI) — Scenario 2") %>%
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
knitr::opts_chunk$set(
collapse = TRUE,
comment = "#>"
)
set.seed(1234)
options(warn = -1)
# Load packages
library(TrialEmulation)
library(dplyr)
library(tidyr)
library(ggplot2)
library(survival)
library(survminer)
library(lubridate)
library(survey)
working_dir <- getwd()
# Extract the estimated propensity score from the ITT analysis
base.weights <- readRDS("obsdata6.rds")
base.trt.w <- base.weights %>% select(id, trt_weight)
# Load the emulated observational data in long format
obsdata5 <- readRDS("obsdata5.rds")
# the time varying variables should use the values in the last period to predict the adherence and censoring probabilities in current period
obsdata5 <- obsdata5 %>%
group_by(id) %>%
arrange(id, follow_up) %>%
mutate(X1.lag = lag(X1),
X2.lag = lag(X2),
age.lag = lag(age)) %>%
ungroup()
obsdata5 <- obsdata5 %>%
mutate(X1.lag = ifelse(follow_up == 0, X1_0, X1.lag),
X2.lag = ifelse(follow_up == 0, X2_0, X2.lag),
age.lag = ifelse(follow_up == 0, age_0, age.lag))
# Add the propensity score to the long data
obsdata6 <- obsdata5 %>% left_join(base.trt.w, by = "id")
attr(obsdata6$trt_weight, "label") <- "Untruncated inverse probability treatment weight"
get_label <- function(x) {
lbl <- attr(x, "label", exact = TRUE)
if (is.null(lbl)) "" else as.character(lbl)
}
dict <- data.frame(
Variable = names(obsdata6),
Meaning  = vapply(obsdata6, get_label, character(1)),
check.names = FALSE
)
knitr::kable(dict, caption = "Data Dictionary", row.names = FALSE)
paper_map_pp <- tibble::tribble(
~Paper_step, ~Description, ~Code_in_this_tutorial,
"PP Step (a)", "Artificial censoring at treatment deviation", "Create adherence indicator section",
"PP Step (b-c)", "Estimate inverse probability treatment and censoring weights", "Create adherence weights + Create loss to follow-up weights",
"PP Step (d)", "Combine stabilized weights", "Convert estimated probabilities into weights and combine them",
"PP Step (e)", "Fit weighted pooled logistic MSM", "Fit a weighted pooled logistic model section"
)
knitr::kable(paper_map_pp, caption = "Paper-to-Code Mapping (PP)", row.names = FALSE)
# Extract initial or assigned treatment
assigned.trt.dat <- obsdata6 %>%
filter(follow_up == 0) %>%
rename(assigned.trt = assigned_treatment) %>%
select(id, assigned.trt)
# Add the initial treatment information to every row of the long data
obsdata7 <- obsdata6 %>% left_join(assigned.trt.dat, by = "id")
obsdata8 <- obsdata7 %>%
mutate(adherence = ifelse((A == assigned.trt) & !is.na(A), 1, 0),
art_censored = 1 - adherence)
# Drop the rows after individuals being artificially censored
obsdata9 <- obsdata8 %>%
group_by(id) %>%
mutate(cum_art_censored = cumsum(art_censored)) %>% # create an indicator of the censored rows
mutate(cum_cum_art_censored = cumsum(cum_art_censored)) %>% # create an indicator to distinguish the first censored month and the months afterward
filter(cum_cum_art_censored %in% c(0, 1)) %>% # keep only data from the adhered months and the first deviation month
select(-cum_art_censored, -cum_cum_art_censored)
# Fit four separate pooled logistic models using a flexible function of time (i.e., time_on_regime)
obsdata10 <- obsdata9 %>% filter(follow_up > 0) # probability of being adhered or on study at baseline is always 1
# Data sets used for making predictions in each treatment group
obsdata_acei <- obsdata10 %>% filter(assigned.trt == 0) %>% ungroup()
obsdata_arb <- obsdata10 %>% filter(assigned.trt == 1)  %>% ungroup()
# Numerator of the adherence model for the ACEI group
adh.model.n0 <- glm(adherence ~  X3 + X4 + X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2), # add back followup for all models!!!
data = obsdata_acei,
family = binomial(link = "logit"))
# Probabilities of being adhered to treatment ACEI for ACEI initiators
adh.prob.n0 <- predict(adh.model.n0, type = "response", newdata = obsdata_acei)
# Denominator of the adherence model for the ACEI group
adh.model.d0 <- glm(adherence ~ X1.lag + X2.lag + X3 + X4 +  X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
data = obsdata_acei,
family = binomial(link = "logit"))
# Probabilities of being adhered to treatment ACEI for ACEI initiators
adh.prob.d0 <- predict(adh.model.d0, type = "response", newdata = obsdata_acei)
# Numerator of the adherence model for the ARB group
adh.model.n1 <- glm(adherence ~  X3 + X4 + X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
data = obsdata_arb,
family = binomial(link = "logit"))
# Probabilities of being adhered to treatment ARB for ARB initiators
adh.prob.n1 <- predict(adh.model.n1, type = "response", newdata = obsdata_arb)
# Denominator of the adherence model for the ARB group
adh.model.d1 <- glm(adherence ~ X1.lag + X2.lag + X3 + X4 + X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
data = obsdata_arb,
family = binomial(link = "logit"))
# Probabilities of being adhered to treatment ARB for ARB initiators
adh.prob.d1 <- predict(adh.model.d1, type = "response", newdata = obsdata_arb)
# Numerator of the loss to follow-up model for the ACEI group
cens.model.n0 <- glm(C ~ X3 + X4 + X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
data = obsdata_acei,
family = binomial(link = "logit"))
# Probabilities of NOT being lost to follow-up for ACEI initiators
cens.prob.n0 <- 1 - predict(cens.model.n0, type = "response", newdata = obsdata_acei)
# Denominator of the loss to follow-up model for the ACEI group
cens.model.d0 <- glm(C ~ X1.lag + X2.lag + X3 + X4 +  X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
data = obsdata_acei,
family = binomial(link = "logit"))
# Probabilities of NOT being lost to follow-up for ACEI initiators
cens.prob.d0 <- 1 - predict(cens.model.d0, type = "response", newdata = obsdata_acei)
cens.model.n1 <- glm(C ~ X3 + X4 + X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
data = obsdata_arb,
family = binomial(link = "logit"))
cens.prob.n1 <- 1 - predict(cens.model.n1, type = "response", newdata = obsdata_arb)
cens.model.d1 <- glm(C ~ X1.lag + X2.lag + X3 + X4 +  X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
data = obsdata_arb,
family = binomial(link = "logit"))
cens.prob.d1 <- 1 - predict(cens.model.d1, type = "response", newdata = obsdata_arb)
# For the ACEI group
obsdata_acei1 <- obsdata_acei %>%
mutate(adh_weight_acei = adh.prob.n0 / adh.prob.d0,   # adherence weights
cens_weight_acei = cens.prob.n0 / cens.prob.d0, # loss to follow-up weights
weight_acei = adh_weight_acei * cens_weight_acei) %>%   # combined time-varying weights
group_by(id) %>%
mutate(weight = cumprod(weight_acei)) %>% # cumulative products of the weights from each month
select(id, follow_up, weight) %>%
ungroup()
# Add the weights to the long observational data
obsdata_acei2 <- obsdata9 %>%
filter(assigned.trt == 0) %>%
left_join(obsdata_acei1, by = c("id", "follow_up")) %>%
mutate(weight = ifelse(follow_up == 0, 1, weight)) # the probability of being adhered and in study at month 0 is 1
# For the ARB group
obsdata_arb1 <- obsdata_arb %>%
mutate(adh_weight_arb = adh.prob.n1 / adh.prob.d1, # adherence weights
cens_weight_arb = cens.prob.n1 / cens.prob.d1, # loss to follow-up weights
weight_arb = adh_weight_arb * cens_weight_arb) %>% # cumulative products of the weights from each month
group_by(id) %>%
mutate(weight = cumprod(weight_arb)) %>% # cumulative products of the weights from each month
select(id, follow_up, weight) %>%
ungroup()
# Add the weights to the long observational data
obsdata_arb2 <- obsdata9 %>%
filter(assigned.trt == 1) %>%
left_join(obsdata_arb1, by = c("id", "follow_up")) %>%
mutate(weight = ifelse(follow_up == 0, 1, weight)) # the probability of being adhered and in study at month 0 is 1
obsdata11 <- bind_rows(obsdata_acei2, obsdata_arb2) %>%
mutate(weight_final = weight * trt_weight) %>% # combine time-varying weights with baseline
select(id, follow_up, X1, X2, X3, X4, age, X1_0, X2_0, X3_0, X4_0, age_0, assigned.trt, Y, C,
weight, trt_weight, weight_final, adherence)
# Visualize the distribution of final weight
obsdata11 %>%
ggplot(aes(x = weight_final)) +
geom_histogram()
summary(obsdata11$weight_final)
# A quick diagnostic for stabilized weights: mean close to 1 is generally desirable.
mean(obsdata11$weight, na.rm = TRUE)
cutoff <- quantile(obsdata11$weight_final, 0.95)
obsdata12 <- obsdata11 %>%
mutate(weight_final_trun = if_else(weight_final > cutoff, cutoff, weight_final))
summary(obsdata12$weight_final_trun)
# Drop the rows where individuals are censored either due to nonadherence or lost to follow-up
outcome.data <- obsdata12 %>% filter(adherence == 1 & C == 0)
# Fit a pooled logistic model
outcome.data.w <- svydesign(ids = ~1, weights = ~weight_final_trun, data = outcome.data)
plr.model <- svyglm(Y ~ assigned.trt + X3 + X4 +  X1_0 + X2_0 + age_0 + follow_up + I(follow_up^2),
design = outcome.data.w,
family = binomial(link = "logit"))
summary(plr.model)
# Extract the treatment effect estimate and 95% confidence interval
est <- summary(plr.model)$coefficients
est <- data.frame(variable = rownames(est), est)
est <- est %>%
filter(variable == "assigned.trt") %>%
mutate(lower = Estimate - 1.96 * Std..Error,
upper = Estimate + 1.96 * Std..Error) %>%
select(variable, Estimate, lower, upper)
est
plr.model.unadj <- glm(Y ~ assigned.trt,
data = outcome.data,
family = binomial(link = "logit"))
summary(plr.model.unadj)
# Extract the treatment effect estimate and 95% confidence interval
est.unadj <- summary(plr.model.unadj)$coefficients
est.unadj <- data.frame(variable = rownames(est.unadj), est.unadj)
est.unadj <- est.unadj %>%
filter(variable == "assigned.trt") %>%
mutate(lower = (Estimate - 1.96 * Std..Error),
upper = (Estimate + 1.96 * Std..Error)) %>%
select(variable, Estimate, lower, upper)
est.unadj
# ?? add a table to present all three results with CIs with everything rounded to 2 decimal places
results <- rbind(
data.frame(variable = "assigned.trt", Estimate = -1.2, lower = NA, upper = NA, Method = "Truth"),
est.unadj %>% mutate(Method = "Unadjusted analysis"),
est %>% mutate(Method = "Per-protocol analysis with IP weights")
)
rownames(results) <- NULL
results
obsdata12_cf0 <- obsdata12 %>%
mutate(assigned.trt = 0) %>%
select(id, follow_up, X1, X2, X3, X4, age, X1_0, X2_0, X3_0, X4_0, age_0, assigned.trt, Y, C, follow_up)
obsdata12_cf1 <- obsdata12 %>%
mutate(assigned.trt = 1) %>%
select(id, follow_up, X1, X2, X3, X4, age, X1_0, X2_0, X3_0, X4_0, age_0, assigned.trt, Y, C, follow_up)
calc_condit_cum_inc <- function(outcome_model, data) {
pred_data <- data %>% select(all_of(c("id", "follow_up", "assigned.trt")))
# Predict probabilities
pred_data$prob_outcome <- predict(outcome_model, newdata = data, type = "response")
# Calculate cumulative incidence for each subject
cum_inc <- pred_data %>%
arrange(.data$id, .data$follow_up) %>%
group_by(.data$id) %>%
mutate(
survival_prob = cumprod(1 - .data$prob_outcome), # P(alive up to current time)
survival_prob_lag = lag(.data$survival_prob, default = 1), # P(alive up to last time)
death_prob = .data$survival_prob_lag * .data$prob_outcome, # P(dead at current time)
cumulative_incidence = cumsum(.data$death_prob)
) %>% ungroup()
return(cum_inc)
}
condit_cum_inc_untreated <- calc_condit_cum_inc(plr.model.unadj, obsdata12_cf0)
condit_cum_inc_treated <- calc_condit_cum_inc(plr.model.unadj, obsdata12_cf1)
marginal_res <- bind_rows(
condit_cum_inc_treated %>% mutate(follow_up_month = as.integer(follow_up / 30)) %>%
group_by(follow_up_month) %>%
summarise(mean_cum_inc = mean(cumulative_incidence, na.rm = TRUE), .groups = "drop") %>%
mutate(treatment = "Treated"),
condit_cum_inc_untreated %>% mutate(follow_up_month = as.integer(follow_up / 30)) %>%
group_by(follow_up_month) %>%
summarise(mean_cum_inc = mean(cumulative_incidence, na.rm = TRUE), .groups = "drop") %>%
mutate(treatment = "Untreated")
)
# Calculate incidence differences and ratios
inc_comp <- marginal_res %>%
select(follow_up_month, treatment, mean_cum_inc) %>%
pivot_wider(names_from = treatment, values_from = mean_cum_inc) %>%
mutate(incidence_diff = Treated - Untreated, incidence_ratio = Treated / Untreated)
# Marginal Cumulative Incidences at different Time Points
key_times <- c(6, 12) # 6 months and 1 year
# find the closest time points in the data stratified by treatment
results <- marginal_res %>%
tidyr::crossing(assess_time = key_times) %>%
filter(follow_up_month >= assess_time) %>%
group_by(treatment, assess_time) %>%
slice_min(follow_up_month, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(treatment, assess_time, mean_cum_inc) %>%
arrange(treatment, assess_time) %>%
pivot_wider(names_from = treatment, values_from = mean_cum_inc)
results
# Risk Differences and Ratios at different Time Points
results1 <- inc_comp %>%
crossing(assess_time = key_times) %>%
filter(follow_up_month >= assess_time) %>%
group_by(assess_time) %>%
slice_min(follow_up_month, n = 1, with_ties = FALSE) %>% select(assess_time, Treated, Untreated, incidence_diff, incidence_ratio) %>%
ungroup()
results.unadj <- results1 %>% mutate(method = "Unadjusted")
condit_cum_inc_untreated <- calc_condit_cum_inc(plr.model, obsdata12_cf0)
condit_cum_inc_treated <- calc_condit_cum_inc(plr.model, obsdata12_cf1)
marginal_res <- bind_rows(
condit_cum_inc_treated %>% mutate(follow_up_month = as.integer(follow_up / 30)) %>%
group_by(follow_up_month) %>%
summarise(mean_cum_inc = mean(cumulative_incidence, na.rm = TRUE), .groups = "drop") %>%
mutate(treatment = "Treated"),
condit_cum_inc_untreated %>% mutate(follow_up_month = as.integer(follow_up / 30)) %>%
group_by(follow_up_month) %>%
summarise(mean_cum_inc = mean(cumulative_incidence, na.rm = TRUE), .groups = "drop") %>%
mutate(treatment = "Untreated")
)
# Calculate incidence differences and ratios
inc_comp <- marginal_res %>%
select(follow_up_month, treatment, mean_cum_inc) %>%
pivot_wider(names_from = treatment, values_from = mean_cum_inc) %>%
mutate(incidence_diff = Treated - Untreated, incidence_ratio = Treated / Untreated)
# Marginal Cumulative Incidences at different Time Points
key_times <- c(6, 12) # 6 months and 1 year
# find the closest time points in the data stratified by treatment
results <- marginal_res %>%
tidyr::crossing(assess_time = key_times) %>%
filter(follow_up_month >= assess_time) %>%
group_by(treatment, assess_time) %>%
slice_min(follow_up_month, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(treatment, assess_time, mean_cum_inc) %>%
arrange(treatment, assess_time) %>%
pivot_wider(names_from = treatment, values_from = mean_cum_inc)
results
# Risk Differences and Ratios at different Time Points
results1 <- inc_comp %>%
crossing(assess_time = key_times) %>%
filter(follow_up_month >= assess_time) %>%
group_by(assess_time) %>%
slice_min(follow_up_month, n = 1, with_ties = FALSE) %>% select(assess_time, Treated, Untreated, incidence_diff, incidence_ratio) %>%
ungroup()
result.pp <- results1 %>% mutate(method = "Per Protocal")
truth <- readRDS("risk_truth.rds")
PP.truth <- truth$PP.truth
assess_time <- c(6, 12)
PP.truth1 <- PP.truth %>% filter(time %in% assess_time) %>% rename(assess_time = time, Treated = cumulative_incidence_trt1, Untreated = cumulative_incidence_trt0, incidence_diff = risk_difference, incidence_ratio = risk_ratio) %>% mutate(method = "Truth")
final_results <- rbind(results.unadj, result.pp, PP.truth1)
final_results %>% arrange(assess_time)
